{
  "manifest_version": 3,
  "name": "Open Folder",
  "version": "1.0",
  "description": "Open a Windows folder from your browser",
  "permissions": ["nativeMessaging"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Folder"
  },
  "background": {
    "service_worker": "background.js"
  }
}
